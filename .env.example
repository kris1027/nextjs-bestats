# Get a read access token: https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_POSTER_PATH=https://image.tmdb.org/t/p/w780
TMDB_BACKDROP_PATH=https://image.tmdb.org/t/p/w1280

# A Neon branch. Local development and preview deployments share the `dev`
# branch; production runs on `main`; CI makes one per run and drops it. Point
# this at `dev` — never at `main`.
# — docs/adr/0009-every-environment-is-a-neon-branch.md
DATABASE_URL=

# `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# This environment's own origin. Vercel sets its own per deployment; locally
# it is the dev server.
BETTER_AUTH_URL=http://localhost:3000

# Where every environment's OAuth callback lands, whichever environment began
# the sign-in. The same value everywhere, which is the whole point of it.
# — docs/adr/0009-every-environment-is-a-neon-branch.md
BETTER_AUTH_PRODUCTION_URL=https://nextjs-bestats.vercel.app

# `openssl rand -base64 32`, and byte-identical in every environment. If it
# differs, the profile encrypted on the way out cannot be decrypted on the way
# back, and the failure reads as a decryption error rather than a
# configuration one.
OAUTH_PROXY_SECRET=

# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI — the production one only, no localhost entry:
#   https://nextjs-bestats.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://github.com/settings/developers
# Authorization callback URL — the production one only:
#   https://nextjs-bestats.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
