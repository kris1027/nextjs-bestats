# Get a read access token: https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_POSTER_PATH=https://image.tmdb.org/t/p/w780
TMDB_BACKDROP_PATH=https://image.tmdb.org/t/p/w1280

# Everything below comes from Neon rather than from typing. There is one
# branch — `main`, which is production — and local development names it too.
# Only CI has a branch of its own.
# — docs/adr/0013-local-development-shares-productions-branch.md
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# The one Neon does not supply: it signs the session cookie, and it is yours.
# `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
