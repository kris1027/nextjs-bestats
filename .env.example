# Get a read access token: https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_POSTER_PATH=https://image.tmdb.org/t/p/w780
TMDB_BACKDROP_PATH=https://image.tmdb.org/t/p/w1280

# Everything below is written by `neon checkout <branch>`, which pulls the
# branch's own values into `.env.local`. Run that rather than filling them in
# by hand, and it will point you at the `dev` branch rather than at `main`.
# — docs/adr/0009-every-environment-is-a-neon-branch.md
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# The one Neon does not supply: it signs the session cookie, and it is yours.
# `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
